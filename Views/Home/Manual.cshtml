@using System.Net
@using System.Text.RegularExpressions
@{
    Layout = null;
    var markdown = (ViewBag.ManualMarkdown as string ?? "").Replace("\r\n", "\n");
    var lang = ViewBag.ManualLanguage as string ?? "fr";
    var lines = markdown.Split('\n');
    var headingIndex = 0;
    var languageNames = new Dictionary<string, string>
    {
        ["fr"] = "Francais",
        ["en"] = "English",
        ["sv"] = "Svenska",
        ["es"] = "Espanol",
        ["de"] = "Deutsch"
    };
    var labels = new Dictionary<string, Dictionary<string, string>>
    {
        ["fr"] = new()
        {
            ["PageTitle"] = "Manuel d'utilisation - EnterpriseERP",
            ["Home"] = "Accueil",
            ["Login"] = "Connexion",
            ["Register"] = "Creer un compte",
            ["Guide"] = "Guide public",
            ["HeroTitle"] = "Manuel d'utilisation EnterpriseERP",
            ["HeroText"] = "Parcourez les fonctions principales avant de vous connecter a l'application.",
            ["Toc"] = "Sommaire",
            ["Language"] = "Langue"
        },
        ["en"] = new()
        {
            ["PageTitle"] = "User Manual - EnterpriseERP",
            ["Home"] = "Home",
            ["Login"] = "Sign in",
            ["Register"] = "Create account",
            ["Guide"] = "Public guide",
            ["HeroTitle"] = "EnterpriseERP User Manual",
            ["HeroText"] = "Browse the main features before signing in to the application.",
            ["Toc"] = "Contents",
            ["Language"] = "Language"
        },
        ["sv"] = new()
        {
            ["PageTitle"] = "Anvandarmanual - EnterpriseERP",
            ["Home"] = "Startsida",
            ["Login"] = "Logga in",
            ["Register"] = "Skapa konto",
            ["Guide"] = "Offentlig guide",
            ["HeroTitle"] = "EnterpriseERP anvandarmanual",
            ["HeroText"] = "Ga igenom de viktigaste funktionerna innan du loggar in i applikationen.",
            ["Toc"] = "Innehall",
            ["Language"] = "Sprak"
        },
        ["es"] = new()
        {
            ["PageTitle"] = "Manual de usuario - EnterpriseERP",
            ["Home"] = "Inicio",
            ["Login"] = "Iniciar sesion",
            ["Register"] = "Crear cuenta",
            ["Guide"] = "Guia publica",
            ["HeroTitle"] = "Manual de usuario de EnterpriseERP",
            ["HeroText"] = "Consulta las funciones principales antes de iniciar sesion en la aplicacion.",
            ["Toc"] = "Contenido",
            ["Language"] = "Idioma"
        },
        ["de"] = new()
        {
            ["PageTitle"] = "Benutzerhandbuch - EnterpriseERP",
            ["Home"] = "Startseite",
            ["Login"] = "Anmelden",
            ["Register"] = "Konto erstellen",
            ["Guide"] = "Offentlicher Leitfaden",
            ["HeroTitle"] = "EnterpriseERP Benutzerhandbuch",
            ["HeroText"] = "Lesen Sie die wichtigsten Funktionen, bevor Sie sich in der Anwendung anmelden.",
            ["Toc"] = "Inhalt",
            ["Language"] = "Sprache"
        }
    };
    string L(string key)
    {
        var current = labels.ContainsKey(lang) ? labels[lang] : labels["fr"];
        return current.TryGetValue(key, out var value) ? value : labels["fr"][key];
    }

    string Slug(string text, int index)
    {
        var normalized = Regex.Replace(text.ToLowerInvariant(), @"[^a-z0-9]+", "-").Trim('-');
        return string.IsNullOrWhiteSpace(normalized) ? $"section-{index}" : $"{normalized}-{index}";
    }

    string Inline(string text)
    {
        var encoded = WebUtility.HtmlEncode(text);
        encoded = Regex.Replace(encoded, @"\*\*(.+?)\*\*", "<strong>$1</strong>");
        encoded = Regex.Replace(encoded, @"`(.+?)`", "<code>$1</code>");
        return encoded;
    }

    var headings = new List<(int Level, string Text, string Id)>();
    foreach (var line in lines)
    {
        var match = Regex.Match(line, @"^(#{1,3})\s+(.+)$");
        if (!match.Success) continue;
        var level = match.Groups[1].Value.Length;
        var text = match.Groups[2].Value.Trim();
        headings.Add((level, text, Slug(text, headings.Count + 1)));
    }
}
<!DOCTYPE html>
<html lang="@lang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@L("PageTitle")</title>
    <link rel="icon" type="image/png" href="/img/enterpriseerp-icon.png" />
    <style>
        :root {
            --bg: #020617;
            --panel: #0f172a;
            --line: #1e293b;
            --text: #f8fafc;
            --muted: #cbd5e1;
            --accent: #8b5cf6;
            --accent-2: #22d3ee;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            background: radial-gradient(circle at top right, rgba(139, 92, 246, .22), transparent 34rem), var(--bg);
            color: var(--text);
            font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        }

        a { color: inherit; text-decoration: none; }

        .manual-nav {
            position: sticky;
            top: 0;
            z-index: 10;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 18px;
            padding: 18px 7%;
            background: rgba(2, 6, 23, .88);
            border-bottom: 1px solid var(--line);
            backdrop-filter: blur(16px);
        }

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            font-weight: 800;
        }

        .brand img {
            width: 38px;
            height: 38px;
            border-radius: 12px;
        }

        .nav-actions {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 10px;
        }

        .manual-lang-form select {
            min-height: 42px;
            border: 1px solid var(--line);
            border-radius: 12px;
            padding: 0 38px 0 14px;
            background: #020617;
            color: var(--text);
            font: inherit;
            font-weight: 750;
        }

        .btn {
            display: inline-flex;
            min-height: 42px;
            align-items: center;
            justify-content: center;
            border: 1px solid var(--line);
            border-radius: 12px;
            padding: 0 16px;
            font-weight: 750;
        }

        .btn-primary {
            border-color: transparent;
            background: linear-gradient(135deg, var(--accent), var(--accent-2));
            color: #fff;
        }

        .hero {
            padding: 72px 7% 34px;
            max-width: 1180px;
        }

        .hero span {
            display: inline-flex;
            margin-bottom: 16px;
            color: #c4b5fd;
            font-size: .8rem;
            font-weight: 850;
            letter-spacing: .08em;
            text-transform: uppercase;
        }

        h1 {
            margin: 0;
            max-width: 900px;
            font-size: clamp(2.4rem, 6vw, 5rem);
            line-height: .95;
            letter-spacing: 0;
        }

        .hero p {
            max-width: 820px;
            color: var(--muted);
            font-size: 1.1rem;
            line-height: 1.75;
        }

        .manual-layout {
            display: grid;
            grid-template-columns: minmax(240px, 320px) minmax(0, 1fr);
            gap: 28px;
            padding: 24px 7% 80px;
            align-items: start;
        }

        .toc {
            position: sticky;
            top: 96px;
            max-height: calc(100vh - 120px);
            overflow: auto;
            padding: 20px;
            background: rgba(15, 23, 42, .82);
            border: 1px solid var(--line);
            border-radius: 18px;
        }

        .toc strong {
            display: block;
            margin-bottom: 14px;
        }

        .toc a {
            display: block;
            margin: 9px 0;
            color: var(--muted);
            line-height: 1.4;
        }

        .toc a.level-2 { padding-left: 12px; }
        .toc a.level-3 { padding-left: 24px; font-size: .92rem; }
        .toc a:hover { color: #fff; }

        .manual-content {
            padding: 30px;
            background: rgba(15, 23, 42, .72);
            border: 1px solid var(--line);
            border-radius: 22px;
        }

        .manual-content h1,
        .manual-content h2,
        .manual-content h3 {
            scroll-margin-top: 110px;
        }

        .manual-content h1 {
            font-size: clamp(2rem, 4vw, 3rem);
            margin: 0 0 18px;
        }

        .manual-content h2 {
            margin: 42px 0 14px;
            padding-top: 24px;
            border-top: 1px solid var(--line);
            font-size: clamp(1.5rem, 3vw, 2.1rem);
        }

        .manual-content h3 {
            margin: 28px 0 10px;
            font-size: 1.25rem;
            color: #e9d5ff;
        }

        .manual-content p,
        .manual-content li {
            color: var(--muted);
            line-height: 1.75;
            font-size: 1rem;
        }

        .manual-content ul {
            padding-left: 22px;
        }

        .manual-content code {
            padding: 2px 6px;
            border-radius: 7px;
            background: #111827;
            color: #bae6fd;
        }

        .manual-content pre {
            overflow: auto;
            padding: 16px;
            border: 1px solid #334155;
            border-radius: 14px;
            background: #020617;
            color: #dbeafe;
        }

        @@media (max-width: 900px) {
            .manual-layout { grid-template-columns: 1fr; }
            .toc { position: static; max-height: none; }
            .manual-nav { align-items: flex-start; flex-direction: column; }
        }
    </style>
</head>
<body>
    <header class="manual-nav">
        <a class="brand" href="/">
            <img src="/img/enterpriseerp-icon.png" alt="EnterpriseERP" />
            <span>EnterpriseERP</span>
        </a>
        <div class="nav-actions">
            <form method="get" action="/Language/Set" class="manual-lang-form">
                <input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" />
                <select name="lang" aria-label="@L("Language")" onchange="this.form.submit()">
                    @foreach (var option in languageNames)
                    {
                        <option value="@option.Key" selected="@(option.Key == lang)">@option.Value</option>
                    }
                </select>
            </form>
            <a class="btn" href="/">@L("Home")</a>
            <a class="btn" href="/Account/Login">@L("Login")</a>
            <a class="btn btn-primary" href="/Account/Register">@L("Register")</a>
        </div>
    </header>

    <section class="hero">
        <span>@L("Guide")</span>
        <h1>@L("HeroTitle")</h1>
        <p>@L("HeroText")</p>
    </section>

    <main class="manual-layout">
        <aside class="toc">
            <strong>@L("Toc")</strong>
            @foreach (var heading in headings)
            {
                <a class="level-@heading.Level" href="#@heading.Id">@heading.Text</a>
            }
        </aside>

        <article class="manual-content">
            @{
                var inCode = false;
                var inList = false;
                foreach (var rawLine in lines)
                {
                    var line = rawLine.TrimEnd();

                    if (line.StartsWith("```"))
                    {
                        if (inList)
                        {
                            @Html.Raw("</ul>")
                            inList = false;
                        }

                        if (!inCode)
                        {
                            @Html.Raw("<pre><code>")
                            inCode = true;
                        }
                        else
                        {
                            @Html.Raw("</code></pre>")
                            inCode = false;
                        }
                        continue;
                    }

                    if (inCode)
                    {
                        @Html.Raw(WebUtility.HtmlEncode(line) + "\n")
                        continue;
                    }

                    if (string.IsNullOrWhiteSpace(line))
                    {
                        if (inList)
                        {
                            @Html.Raw("</ul>")
                            inList = false;
                        }
                        continue;
                    }

                    var headingMatch = Regex.Match(line, @"^(#{1,3})\s+(.+)$");
                    if (headingMatch.Success)
                    {
                        if (inList)
                        {
                            @Html.Raw("</ul>")
                            inList = false;
                        }

                        headingIndex++;
                        var level = headingMatch.Groups[1].Value.Length;
                        var text = headingMatch.Groups[2].Value.Trim();
                        var id = Slug(text, headingIndex);
                        @Html.Raw($"<h{level} id=\"{id}\">{Inline(text)}</h{level}>")
                        continue;
                    }

                    if (line.StartsWith("- "))
                    {
                        if (!inList)
                        {
                            @Html.Raw("<ul>")
                            inList = true;
                        }
                        @Html.Raw($"<li>{Inline(line[2..])}</li>")
                        continue;
                    }

                    if (inList)
                    {
                        @Html.Raw("</ul>")
                        inList = false;
                    }

                    @Html.Raw($"<p>{Inline(line)}</p>")
                }

                if (inList)
                {
                    @Html.Raw("</ul>")
                }
                if (inCode)
                {
                    @Html.Raw("</code></pre>")
                }
            }
        </article>
    </main>
</body>
</html>
