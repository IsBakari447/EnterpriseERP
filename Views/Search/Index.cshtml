@inject EnterpriseERP.Services.TranslationService T

@{
    var type = ViewBag.Type as string ?? "all";
    var query = ViewBag.Query as string ?? "";

    string pageTitleKey = type switch
    {
        "clients" => "SearchClients",
        "employees" => "SearchEmployees",
        "products" => "SearchProducts",
        "invoices" => "SearchInvoices",
        "stock" => "SearchStock",
        "presence" => "SearchPresences",
        _ => "GlobalSearch"
    };

    ViewData["Title"] = T.T(pageTitleKey);

    var employees = ViewBag.Employees as List<EnterpriseERP.Models.Employee>;
    var clients = ViewBag.Clients as List<EnterpriseERP.Models.Client>;
    var products = ViewBag.Products as List<EnterpriseERP.Models.Product>;
    var invoices = ViewBag.Invoices as List<EnterpriseERP.Models.Invoice>;
    var stockMovements = ViewBag.StockMovements as List<EnterpriseERP.Models.StockMovement>;
    var presences = ViewBag.Presences as List<EnterpriseERP.Models.Presence>;
}

<div class="page-header">
    <div>
        <h1>@T.T(pageTitleKey)</h1>
        <p>
            @T.T("Category"):
            <strong>@type</strong>
            -
            @T.T("ResultsFor"):
            <strong>@query</strong>
        </p>
    </div>

    <a href="/Dashboard/Index" class="btn-secondary">
        @T.T("BackToDashboard")
    </a>
</div>

@if (type == "all" || type == "employees")
{
    <div class="panel">
        <h2>@T.T("Employees")</h2>

        @if (employees != null && employees.Any())
        {
            <table>
                <thead>
                    <tr>
                        <th>@T.T("Name")</th>
                        <th>@T.T("Position")</th>
                        <th>@T.T("Email")</th>
                        <th>@T.T("Phone")</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var e in employees)
                    {
                        <tr>
                            <td>@e.FullName</td>
                            <td>@e.Position</td>
                            <td>@e.Email</td>
                            <td>@e.Phone</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="empty">@T.T("NoEmployeeFound")</p>
        }
    </div>
}

@if (type == "all" || type == "clients")
{
    <div class="panel">
        <h2>@T.T("Clients")</h2>

        @if (clients != null && clients.Any())
        {
            <table>
                <thead>
                    <tr>
                        <th>@T.T("Name")</th>
                        <th>@T.T("Company")</th>
                        <th>@T.T("Email")</th>
                        <th>@T.T("Phone")</th>
                        <th>@T.T("Address")</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var c in clients)
                    {
                        <tr>
                            <td>@c.FullName</td>
                            <td>@c.CompanyName</td>
                            <td>@c.Email</td>
                            <td>@c.Phone</td>
                            <td>@c.Address</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="empty">@T.T("NoClientFound")</p>
        }
    </div>
}

@if (type == "all" || type == "products")
{
    <div class="panel">
        <h2>@T.T("Products")</h2>

        @if (products != null && products.Any())
        {
            <table>
                <thead>
                    <tr>
                        <th>@T.T("Product")</th>
                        <th>@T.T("Category")</th>
                        <th>@T.T("PurchasePrice")</th>
                        <th>@T.T("SalePrice")</th>
                        <th>@T.T("Stock")</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var p in products)
                    {
                        <tr>
                            <td>@p.Name</td>
                            <td>@p.Category</td>
                            <td>@p.PurchasePrice &euro;</td>
                            <td>@p.SalePrice &euro;</td>
                            <td>@p.Quantity</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="empty">@T.T("NoProductFound")</p>
        }
    </div>
}

@if (type == "all" || type == "invoices")
{
    <div class="panel">
        <h2>@T.T("Invoices")</h2>

        @if (invoices != null && invoices.Any())
        {
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>@T.T("Client")</th>
                        <th>@T.T("Date")</th>
                        <th>@T.T("Total")</th>
                        <th>@T.T("Status")</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var i in invoices)
                    {
                        <tr>
                            <td>#@i.Id</td>
                            <td>@i.Client?.FullName</td>
                            <td>@i.InvoiceDate.ToString("dd/MM/yyyy")</td>
                            <td>@i.TotalAmount &euro;</td>
                            <td>@i.Status</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="empty">@T.T("NoInvoiceFound")</p>
        }
    </div>
}

@if (type == "all" || type == "stock")
{
    <div class="panel">
        <h2>@T.T("Stock")</h2>

        @if (stockMovements != null && stockMovements.Any())
        {
            <table>
                <thead>
                    <tr>
                        <th>@T.T("Product")</th>
                        <th>@T.T("MovementType")</th>
                        <th>@T.T("Quantity")</th>
                        <th>@T.T("Date")</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var s in stockMovements)
                    {
                        <tr>
                            <td>@s.Product?.Name</td>
                            <td>@s.Type</td>
                            <td>@s.Quantity</td>
                            <td>@s.Date.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="empty">@T.T("NoStockMovementFound")</p>
        }
    </div>
}

@if (type == "all" || type == "presence")
{
    <div class="panel">
        <h2>@T.T("Presences")</h2>

        @if (presences != null && presences.Any())
        {
            <table>
                <thead>
                    <tr>
                        <th>@T.T("Employees")</th>
                        <th>@T.T("Date")</th>
                        <th>@T.T("Entry")</th>
                        <th>@T.T("Exit")</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var p in presences)
                    {
                        <tr>
                            <td>@p.Employee?.FullName</td>
                            <td>@p.Date.ToString("dd/MM/yyyy")</td>
                            <td>@p.CheckIn</td>
                            <td>@p.CheckOut</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="empty">@T.T("NoPresenceFound")</p>
        }
    </div>
}
