@model EnterpriseERP.Models.Supplier
@inject EnterpriseERP.Services.TranslationService T

@{
    ViewData["Title"] = T.T("AddSupplier");
}

<div class="page-header">
    <div>
        <h1>@T.T("AddSupplier")</h1>
        <p>@T.T("CreateSupplierRecord")</p>
    </div>

    <a href="/Suppliers/Index" class="btn-secondary">
        @T.T("Back")
    </a>
</div>

<div class="form-card">
    @if (ViewBag.Error != null)
    {
        <div class="alert-error">@ViewBag.Error</div>
    }

    <form method="post" action="/Suppliers/Create">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label>@T.T("SupplierName")</label>
            <input name="Name" value="@Model?.Name" required />
        </div>

        <div class="form-group">
            <label>@T.T("ContactPerson")</label>
            <input name="ContactPerson" value="@Model?.ContactPerson" />
        </div>

        <div class="form-group">
            <label>@T.T("Email")</label>
            <input name="Email" type="email" value="@Model?.Email" />
        </div>

        <div class="form-group">
            <label>@T.T("Phone")</label>
            <input name="Phone" value="@Model?.Phone" />
        </div>

        <div class="form-group">
            <label>@T.T("Category")</label>
            <input name="Category" value="@Model?.Category" placeholder="Ex: Informatique, Transport, Alimentaire..." />
        </div>

        <div class="form-group">
            <label>@T.T("Address")</label>
            <input name="Address" value="@Model?.Address" />
        </div>

        <button type="submit" class="btn-primary">
            @T.T("Save")
        </button>
    </form>
</div>
