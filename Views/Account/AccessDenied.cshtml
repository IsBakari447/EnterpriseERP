@inject EnterpriseERP.Services.TranslationService T

@{
    ViewData["Title"] = T.T("AccessDenied");
}

<div class="page-header">
    <div>
        <h1>@T.T("AccessDenied")</h1>
        <p>@T.T("AccessDeniedText")</p>
    </div>

    <a href="/Dashboard/Index" class="btn-secondary">
        @T.T("BackToDashboard")
    </a>
</div>

<div class="panel">
    <h2>@T.T("InsufficientAuthorization")</h2>
    <p>@T.T("ContactAdminIfError")</p>
</div>
