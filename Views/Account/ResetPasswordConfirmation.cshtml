@inject EnterpriseERP.Services.TranslationService T
@{
    Layout = null;
    ViewData["Title"] = T.T("ResetPasswordConfirmationTitle");
}

<!DOCTYPE html>
<html lang="@T.Lang">
<head>
    <meta charset="utf-8" />
    <title>@T.T("ResetPasswordConfirmationTitle")</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100vh;
            font-family: "Segoe UI", Arial, sans-serif;
            background: #020617;
            color: #e5e7eb;
            display: grid;
            place-items: center;
            padding: 24px;
        }
        .card {
            width: min(100%, 460px);
            background: rgba(2,6,23,.94);
            border: 1px solid #334155;
            border-radius: 24px;
            padding: 34px;
            text-align: center;
            box-shadow: 0 28px 90px rgba(0,0,0,.4);
        }
        h1 { margin: 0 0 10px; font-size: 30px; color: #fff; }
        p { color: #cbd5e1; line-height: 1.6; }
        a {
            display: inline-block;
            margin-top: 18px;
            border-radius: 14px;
            background: #7c3aed;
            color: #fff;
            padding: 14px 18px;
            text-decoration: none;
            font-weight: 800;
        }
    </style>
</head>
<body>
    <main class="card">
        <h1>@T.T("ResetPasswordConfirmationTitle")</h1>
        <p>@T.T("ResetPasswordConfirmationText")</p>
        <a asp-controller="Account" asp-action="Login">@T.T("BackToLogin")</a>
    </main>
</body>
</html>
