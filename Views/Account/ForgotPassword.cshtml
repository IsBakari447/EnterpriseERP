@inject EnterpriseERP.Services.TranslationService T
@{
    Layout = null;
    ViewData["Title"] = T.T("ForgotPasswordTitle");
}

<!DOCTYPE html>
<html lang="@T.Lang">
<head>
    <meta charset="utf-8" />
    <title>@T.T("ForgotPasswordTitle")</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            min-height: 100vh;
            font-family: "Segoe UI", Arial, sans-serif;
            background: radial-gradient(circle at top left, rgba(124,58,237,.32), transparent 36%), #020617;
            color: #e5e7eb;
            display: grid;
            place-items: center;
            padding: 24px;
        }
        .card {
            width: min(100%, 460px);
            background: rgba(2,6,23,.94);
            border: 1px solid #334155;
            border-radius: 24px;
            padding: 34px;
            box-shadow: 0 28px 90px rgba(0,0,0,.4);
        }
        h1 { margin: 0 0 10px; font-size: 30px; color: #fff; }
        p { margin: 0 0 22px; color: #cbd5e1; line-height: 1.6; }
        label { display: block; margin-bottom: 8px; font-weight: 700; color: #cbd5e1; }
        input {
            width: 100%;
            border: 1px solid #334155;
            border-radius: 14px;
            background: #0f172a;
            color: #fff;
            padding: 15px;
            font-size: 15px;
            outline: none;
        }
        input:focus { border-color: #8b5cf6; box-shadow: 0 0 0 3px rgba(139,92,246,.18); }
        .btn {
            width: 100%;
            margin-top: 20px;
            border: 0;
            border-radius: 14px;
            background: #7c3aed;
            color: white;
            padding: 15px;
            font-size: 16px;
            font-weight: 800;
            cursor: pointer;
        }
        .alert {
            border-radius: 14px;
            padding: 12px;
            margin-bottom: 18px;
            font-size: 14px;
        }
        .error { background: rgba(127,29,29,.75); color: #fecaca; border: 1px solid #ef4444; }
        .success { background: rgba(6,78,59,.78); color: #bbf7d0; border: 1px solid #10b981; }
        .links { margin-top: 20px; display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
        a { color: #a78bfa; text-decoration: none; font-weight: 800; }
    </style>
</head>
<body>
    <main class="card">
        <h1>@T.T("ForgotPasswordTitle")</h1>
        <p>@T.T("ForgotPasswordSubtitle")</p>

        @if (ViewBag.Error != null)
        {
            <div class="alert error">@ViewBag.Error</div>
        }
        @if (ViewBag.Success != null)
        {
            <div class="alert success">@ViewBag.Success</div>
        }

        <form asp-controller="Account" asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()
            <label for="email">@T.T("EmailAddress")</label>
            <input id="email" type="email" name="email" autocomplete="email" placeholder="email@exemple.com" required />
            <button class="btn" type="submit">@T.T("SendVerificationCode")</button>
        </form>

        <div class="links">
            <a asp-controller="Account" asp-action="Login">@T.T("BackToLogin")</a>
            <a asp-controller="Account" asp-action="ResetPassword">@T.T("IHaveCode")</a>
            <a href="/">@T.T("Home")</a>
        </div>
    </main>
</body>
</html>
