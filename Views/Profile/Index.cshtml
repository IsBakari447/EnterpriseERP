@model EnterpriseERP.Models.User
@inject EnterpriseERP.Services.TranslationService T

@{
    ViewData["Title"] = T.T("UserProfile");
}

<div class="page-header">
    <div>
        <h1>@T.T("UserProfile")</h1>
        <p>@T.T("UserProfileText")</p>
    </div>

    <div class="header-actions">
        @if (Context.Session.GetString("IsSuperAdmin") == "true" ||
             Context.Session.GetString("UserRole") == "Admin")
        {
            <a href="/Account/Register" class="btn-primary">
                @T.T("CreateUser")
            </a>
        }

        <a href="/Dashboard/Index" class="btn-secondary">
            @T.T("BackToDashboard")
        </a>
    </div>
</div>

<div class="dashboard-grid">
    <div class="form-card">
        <div class="user-chip" style="margin-bottom:20px;">
            <div class="avatar">
                @((Model.FullName ?? "U").Substring(0, 1).ToUpper())
            </div>

            <div class="user-info">
                <strong>@Model.FullName</strong>
                <span>@Model.Role</span>
            </div>
        </div>

        <div class="form-group">
            <label>@T.T("FullName")</label>
            <input value="@Model.FullName" readonly />
        </div>

        <div class="form-group">
            <label>@T.T("Email")</label>
            <input value="@Model.Email" readonly />
        </div>

        <div class="form-group">
            <label>@T.T("Role")</label>
            <input value="@Model.Role" readonly />
        </div>

        <div class="form-group">
            <label>@T.T("Phone")</label>
            <input value="@Model.Phone" readonly />
        </div>

        <div class="form-group">
            <label>@T.T("Address")</label>
            <input value="@Model.Address" readonly />
        </div>

        <div class="form-group">
            <label>@T.T("Department")</label>
            <input value="@Model.Department" readonly />
        </div>

        <div class="form-group">
            <label>@T.T("Position")</label>
            <input value="@Model.Position" readonly />
        </div>

        <div class="dashboard-grid" style="margin-top:20px;">
            <a href="/Profile/Edit" class="btn-primary">
                @T.T("EditProfile")
            </a>

            <a href="/Account/Logout" class="btn-danger">
                @T.T("Logout")
            </a>
        </div>
    </div>

    <div class="panel">
        <h2>@T.T("SystemInformation")</h2>

        <table>
            <tr>
                <th>@T.T("ActiveAccount")</th>
                <td>@(Model.IsActive ? T.T("Yes") : T.T("No"))</td>
            </tr>

            <tr>
                <th>@T.T("ApprovedAccount")</th>
                <td>@(Model.IsApproved ? T.T("Yes") : T.T("No"))</td>
            </tr>

            <tr>
                <th>SuperAdmin</th>
                <td>@(Model.IsSuperAdmin ? T.T("Yes") : T.T("No"))</td>
            </tr>

            <tr>
                <th>@T.T("PreferredLanguage")</th>
                <td>@Model.PreferredLanguage</td>
            </tr>

            <tr>
                <th>@T.T("PreferredTheme")</th>
                <td>@Model.Theme</td>
            </tr>

            <tr>
                <th>@T.T("CreatedAt")</th>
                <td>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
            </tr>

            <tr>
                <th>@T.T("UpdatedAt")</th>
                <td>@Model.UpdatedAt?.ToString("dd/MM/yyyy HH:mm")</td>
            </tr>

            <tr>
                <th>@T.T("LastLogin")</th>
                <td>@Model.LastConnection?.ToString("dd/MM/yyyy HH:mm")</td>
            </tr>

            <tr>
                <th>@T.T("LoginCount")</th>
                <td>@Model.LoginCount</td>
            </tr>

            <tr>
                <th>@T.T("LastIp")</th>
                <td>@Model.LastIPAddress</td>
            </tr>
        </table>
    </div>
</div>
