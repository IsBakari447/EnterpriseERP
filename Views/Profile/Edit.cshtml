@model EnterpriseERP.Models.User
@inject EnterpriseERP.Services.TranslationService T

@{
    ViewData["Title"] = T.T("EditProfile");
}

<div class="page-header">
    <div>
        <h1>@T.T("EditProfile")</h1>
        <p>@T.T("EditProfileDescription")</p>
    </div>

    <a href="/Profile/Index" class="btn-secondary">
        @T.T("BackToProfile")
    </a>
</div>

<div class="form-card">
    <form method="post" action="/Profile/Edit">
        @Html.AntiForgeryToken()

        <input type="hidden" name="id" value="@Model.Id" />

        <div class="form-group">
            <label>@T.T("FullName")</label>
            <input value="@Model.FullName" readonly />
        </div>

        <div class="form-group">
            <label>@T.T("Email")</label>
            <input value="@Model.Email" readonly />
        </div>

        <div class="form-group">
            <label>@T.T("Phone")</label>
            <input name="Phone" value="@Model.Phone" />
        </div>

        <div class="form-group">
            <label>@T.T("Address")</label>
            <input name="Address" value="@Model.Address" />
        </div>

        <div class="form-group">
            <label>@T.T("Department")</label>
            <input name="Department" value="@Model.Department" placeholder="Ex: Comptabilite, Stock, RH..." />
        </div>

        <div class="form-group">
            <label>@T.T("Position")</label>
            <input name="Position" value="@Model.Position" placeholder="Ex: Manager, Comptable..." />
        </div>

        <div class="form-group">
            <label>@T.T("PreferredLanguage")</label>
            <select name="PreferredLanguage">
                <option value="fr" selected="@(Model.PreferredLanguage == "fr")">Francais</option>
                <option value="en" selected="@(Model.PreferredLanguage == "en")">English</option>
                <option value="sv" selected="@(Model.PreferredLanguage == "sv")">Svenska</option>
            </select>
        </div>

        <div class="form-group">
            <label>@T.T("PreferredTheme")</label>
            <select name="Theme">
                <option value="Dark" selected="@(Model.Theme == "Dark")">@T.T("DarkMode")</option>
                <option value="Light" selected="@(Model.Theme == "Light")">@T.T("LightMode")</option>
            </select>
        </div>

        <button type="submit" class="btn-primary">
            @T.T("SaveChanges")
        </button>
    </form>
</div>
