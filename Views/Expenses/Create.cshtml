@model EnterpriseERP.Models.Expense
@inject EnterpriseERP.Services.TranslationService T

@{
    ViewData["Title"] = T.T("NewExpense");
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>@T.T("NewExpense")</h2>
            <p class="text-muted">@T.T("NewExpenseDescription")</p>
        </div>

        <a asp-action="Index" class="btn btn-secondary">
            @T.T("Back")
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Title" class="form-label">@T.T("Title")</label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Category" class="form-label">@T.T("Category")</label>
                        <select asp-for="Category" class="form-select">
                            <option value="">@T.T("Select")</option>
                            <option>Transport</option>
                            <option>Carburant</option>
                            <option>Salaire</option>
                            <option>Loyer</option>
                            <option>Electricite</option>
                            <option>Eau</option>
                            <option>Internet</option>
                            <option>Telephone</option>
                            <option>Maintenance</option>
                            <option>Materiel</option>
                            <option>Fournitures</option>
                            <option>Marketing</option>
                            <option>Taxes</option>
                            <option>Autres</option>
                        </select>
                        <span asp-validation-for="Category" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Amount" class="form-label">@T.T("Amount")</label>
                        <input asp-for="Amount" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="Amount" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="ExpenseDate" class="form-label">@T.T("Date")</label>
                        <input asp-for="ExpenseDate" class="form-control" type="date" />
                        <span asp-validation-for="ExpenseDate" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="PaymentMethod" class="form-label">@T.T("PaymentMethod")</label>
                        <select asp-for="PaymentMethod" class="form-select">
                            <option value="">@T.T("Select")</option>
                            <option>@T.T("Cash")</option>
                            <option>@T.T("Card")</option>
                            <option>@T.T("BankTransfer")</option>
                            <option>Mobile Money</option>
                            <option>Cheque</option>
                        </select>
                    </div>

                    <div class="col-12 mb-3">
                        <label asp-for="Description" class="form-label">@T.T("Description")</label>
                        <textarea asp-for="Description" rows="4" class="form-control"></textarea>
                    </div>
                </div>

                <hr />

                <button type="submit" class="btn btn-success">
                    @T.T("SaveExpense")
                </button>

                <a asp-action="Index" class="btn btn-outline-secondary">
                    @T.T("Cancel")
                </a>
            </form>
        </div>
    </div>
</div>

@section Scripts{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
