@inject EnterpriseERP.Services.TranslationService T

@{
    ViewData["Title"] = T.T("Notifications");

    var outOfStockProducts = ViewBag.OutOfStockProducts as List<EnterpriseERP.Models.Product>;
    var lowStockProducts = ViewBag.LowStockProducts as List<EnterpriseERP.Models.Product>;
    var unpaidInvoices = ViewBag.UnpaidInvoices as List<EnterpriseERP.Models.Invoice>;
    var pendingOrders = ViewBag.PendingOrders as List<EnterpriseERP.Models.Order>;
    var recentPayments = ViewBag.RecentPayments as List<EnterpriseERP.Models.Payment>;
    var pendingUsers = ViewBag.PendingUsers as List<EnterpriseERP.Models.User>;
    var todayPresences = ViewBag.TodayPresences as List<EnterpriseERP.Models.Presence>;
}

<div class="page-header">
    <div>
        <h1>@T.T("AdvancedNotifications")</h1>
        <p>@T.T("NotificationsCenterText")</p>
    </div>

    <a href="/Dashboard/Index" class="btn-secondary">
        @T.T("BackToDashboard")
    </a>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-icon">!</div>
        <div>
            <h3>@ViewBag.TotalAlerts</h3>
            <p>@T.T("ImportantAlerts")</p>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon">0</div>
        <div>
            <h3>@(outOfStockProducts?.Count ?? 0)</h3>
            <p>@T.T("OutOfStockProducts")</p>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon">%</div>
        <div>
            <h3>@(lowStockProducts?.Count ?? 0)</h3>
            <p>@T.T("LowStock")</p>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon">#</div>
        <div>
            <h3>@(unpaidInvoices?.Count ?? 0)</h3>
            <p>@T.T("InvoicesToFollow")</p>
        </div>
    </div>
</div>

<div class="dashboard-grid">
    <div class="panel">
        <h2>@T.T("OutOfStockProducts")</h2>

        @if (outOfStockProducts != null && outOfStockProducts.Any())
        {
            <table>
                <thead>
                    <tr>
                        <th>@T.T("Product")</th>
                        <th>@T.T("Category")</th>
                        <th>@T.T("Stock")</th>
                        <th>@T.T("Actions")</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var product in outOfStockProducts)
                    {
                        <tr>
                            <td>@product.Name</td>
                            <td>@product.Category</td>
                            <td>@product.Quantity</td>
                            <td>
                                <a href="/Stock/Movement" class="btn-primary">@T.T("Restock")</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="empty">@T.T("NoOutOfStockProduct")</p>
        }
    </div>

    <div class="panel">
        <h2>@T.T("LowStock")</h2>

        @if (lowStockProducts != null && lowStockProducts.Any())
        {
            <table>
                <thead>
                    <tr>
                        <th>@T.T("Product")</th>
                        <th>@T.T("Category")</th>
                        <th>@T.T("RemainingStock")</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var product in lowStockProducts)
                    {
                        <tr>
                            <td>@product.Name</td>
                            <td>@product.Category</td>
                            <td>@product.Quantity</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="empty">@T.T("NoLowStock")</p>
        }
    </div>
</div>

<div class="dashboard-grid">
    <div class="panel">
        <h2>@T.T("UnpaidPendingInvoices")</h2>

        @if (unpaidInvoices != null && unpaidInvoices.Any())
        {
            <table>
                <thead>
                    <tr>
                        <th>@T.T("Number")</th>
                        <th>@T.T("Client")</th>
                        <th>@T.T("Date")</th>
                        <th>@T.T("Total")</th>
                        <th>@T.T("Status")</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var invoice in unpaidInvoices)
                    {
                        <tr>
                            <td>#@invoice.Id</td>
                            <td>@invoice.Client?.FullName</td>
                            <td>@invoice.InvoiceDate.ToString("dd/MM/yyyy")</td>
                            <td>@invoice.TotalAmount &euro;</td>
                            <td>@invoice.Status</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="empty">@T.T("NoUnpaidInvoice")</p>
        }
    </div>

    <div class="panel">
        <h2>@T.T("PendingOrders")</h2>

        @if (pendingOrders != null && pendingOrders.Any())
        {
            <table>
                <thead>
                    <tr>
                        <th>@T.T("Number")</th>
                        <th>@T.T("Client")</th>
                        <th>@T.T("Product")</th>
                        <th>@T.T("Quantity")</th>
                        <th>@T.T("Date")</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var order in pendingOrders)
                    {
                        <tr>
                            <td>#@order.Id</td>
                            <td>@order.Client?.FullName</td>
                            <td>@order.Product?.Name</td>
                            <td>@order.Quantity</td>
                            <td>@order.OrderDate.ToString("dd/MM/yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="empty">@T.T("NoPendingOrder")</p>
        }
    </div>
</div>

<div class="dashboard-grid">
    <div class="panel">
        <h2>@T.T("RecentPayments")</h2>

        @if (recentPayments != null && recentPayments.Any())
        {
            <table>
                <thead>
                    <tr>
                        <th>@T.T("Invoice")</th>
                        <th>@T.T("Client")</th>
                        <th>@T.T("Amount")</th>
                        <th>@T.T("Method")</th>
                        <th>@T.T("Date")</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var payment in recentPayments)
                    {
                        <tr>
                            <td>#@payment.InvoiceId</td>
                            <td>@payment.Invoice?.Client?.FullName</td>
                            <td>@payment.Amount &euro;</td>
                            <td>@payment.Method</td>
                            <td>@payment.PaymentDate.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="empty">@T.T("NoRecentPayment")</p>
        }
    </div>

    <div class="panel">
        <h2>@T.T("UsersToWatch")</h2>

        @if (pendingUsers != null && pendingUsers.Any())
        {
            <table>
                <thead>
                    <tr>
                        <th>@T.T("Name")</th>
                        <th>@T.T("Email")</th>
                        <th>@T.T("Role")</th>
                        <th>@T.T("Active")</th>
                        <th>@T.T("Approved")</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var user in pendingUsers)
                    {
                        <tr>
                            <td>@user.FullName</td>
                            <td>@user.Email</td>
                            <td>@user.Role</td>
                            <td>@(user.IsActive ? T.T("Yes") : T.T("No"))</td>
                            <td>@(user.IsApproved ? T.T("Yes") : T.T("No"))</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="empty">@T.T("NoUserToWatch")</p>
        }
    </div>
</div>

<div class="panel">
    <h2>@T.T("TodayPresences")</h2>

    @if (todayPresences != null && todayPresences.Any())
    {
        <table>
            <thead>
                <tr>
                    <th>@T.T("Employees")</th>
                    <th>@T.T("Entry")</th>
                    <th>@T.T("Exit")</th>
                    <th>@T.T("Date")</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var presence in todayPresences)
                {
                    <tr>
                        <td>@presence.Employee?.FullName</td>
                        <td>@presence.CheckIn</td>
                        <td>@presence.CheckOut</td>
                        <td>@presence.Date.ToString("dd/MM/yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="empty">@T.T("NoPresenceToday")</p>
    }
</div>
