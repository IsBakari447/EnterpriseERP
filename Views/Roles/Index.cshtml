@using EnterpriseERP.Models
@inject EnterpriseERP.Services.TranslationService T

@{
    ViewData["Title"] = T.T("RolesManagement");
    var roles = ViewBag.Roles as List<string>;
    var permissions = ViewBag.Permissions as List<Permission>;
    var rolePermissions = ViewBag.RolePermissions as List<RolePermission>;
}

<div class="page-header">
    <div>
        <h1>@T.T("RolesManagementTitle")</h1>
        <p>@T.T("RolesManagementText")</p>
    </div>

    <a href="/Dashboard/Index" class="btn-secondary">
        @T.T("BackToDashboard")
    </a>
</div>

@if (roles != null)
{
    foreach (var role in roles)
    {
        <div class="panel" style="margin-bottom:35px;">
            <h2>@role</h2>

            <form asp-action="Update" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="role" value="@role" />

                <table class="table">
                    <thead>
                        <tr>
                            <th style="width:250px;">@T.T("Module")</th>
                            <th>@T.T("Action")</th>
                            <th style="width:120px;">@T.T("Allowed")</th>
                        </tr>
                    </thead>

                    <tbody>
                    @foreach (var permission in permissions!)
                    {
                        bool allowed = rolePermissions!.Any(r => r.Role == role && r.PermissionId == permission.Id);
                        <tr>
                            <td>@permission.Module</td>
                            <td>@permission.Action</td>
                            <td>
                                <input type="checkbox" name="permissionIds" value="@permission.Id" @(allowed ? "checked" : "") />
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>

                <button class="btn-primary" type="submit">
                    @T.T("SavePermissions")
                </button>
            </form>
        </div>
    }
}
