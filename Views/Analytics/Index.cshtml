@using EnterpriseERP.Controllers
@using EnterpriseERP.Models
@inject EnterpriseERP.Services.TranslationService T

@{
    ViewData["Title"] = T.T("Analytics");
    var revenueByMethod = ViewBag.RevenueByMethod as List<AnalyticsRow> ?? new();
    var expensesByCategory = ViewBag.ExpensesByCategory as List<AnalyticsRow> ?? new();
    var recentInvoices = ViewBag.RecentInvoices as List<Invoice> ?? new();
}

<div class="page-header">
    <div>
        <h1>@T.T("Analytics")</h1>
        <p>@T.T("AnalyticsDescription")</p>
    </div>

    <a href="/Admin/Index" class="btn-secondary">@T.T("BackToAdministration")</a>
</div>

<div class="stats-grid">
    <div class="stat-card"><div class="stat-icon">REV</div><div><h3>@ViewBag.TotalRevenue.ToString("N2") EUR</h3><p>@T.T("TotalRevenue")</p></div></div>
    <div class="stat-card"><div class="stat-icon">MON</div><div><h3>@ViewBag.MonthRevenue.ToString("N2") EUR</h3><p>@T.T("MonthRevenue")</p></div></div>
    <div class="stat-card"><div class="stat-icon">EXP</div><div><h3>@ViewBag.TotalExpenses.ToString("N2") EUR</h3><p>@T.T("TotalExpenses")</p></div></div>
    <div class="stat-card"><div class="stat-icon">NET</div><div><h3>@ViewBag.NetProfit.ToString("N2") EUR</h3><p>@T.T("NetProfit")</p></div></div>
</div>

<div class="stats-grid">
    <div class="stat-card"><div class="stat-icon">CLI</div><div><h3>@ViewBag.TotalClients</h3><p>@T.T("Clients")</p></div></div>
    <div class="stat-card"><div class="stat-icon">PRO</div><div><h3>@ViewBag.TotalProducts</h3><p>@T.T("Products")</p></div></div>
    <div class="stat-card"><div class="stat-icon">QUO</div><div><h3>@ViewBag.TotalQuotes</h3><p>@T.T("Quotes")</p></div></div>
    <div class="stat-card warning"><div class="stat-icon">INV</div><div><h3>@ViewBag.UnpaidInvoices</h3><p>@T.T("InvoicesToFollow")</p></div></div>
</div>

<div class="dashboard-grid">
    <div class="panel">
        <h2>@T.T("RevenueByMethod")</h2>
        @if (revenueByMethod.Any())
        {
            <table>
                <thead><tr><th>@T.T("Method")</th><th>@T.T("Total")</th></tr></thead>
                <tbody>
                @foreach (var row in revenueByMethod)
                {
                    <tr><td>@row.Label</td><td>@row.Value.ToString("N2") EUR</td></tr>
                }
                </tbody>
            </table>
        }
        else
        {
            <p class="empty">@T.T("NoPaymentRecorded")</p>
        }
    </div>

    <div class="panel">
        <h2>@T.T("ExpensesByCategory")</h2>
        @if (expensesByCategory.Any())
        {
            <table>
                <thead><tr><th>@T.T("Category")</th><th>@T.T("Total")</th></tr></thead>
                <tbody>
                @foreach (var row in expensesByCategory)
                {
                    <tr><td>@row.Label</td><td>@row.Value.ToString("N2") EUR</td></tr>
                }
                </tbody>
            </table>
        }
        else
        {
            <p class="empty">@T.T("NoExpenseRecorded")</p>
        }
    </div>
</div>

<div class="panel">
    <h2>@T.T("LatestInvoices")</h2>
    @if (recentInvoices.Any())
    {
        <table>
            <thead><tr><th>@T.T("Number")</th><th>@T.T("Client")</th><th>@T.T("Date")</th><th>@T.T("Total")</th><th>@T.T("Status")</th></tr></thead>
            <tbody>
            @foreach (var invoice in recentInvoices)
            {
                <tr>
                    <td>@invoice.InvoiceNumber</td>
                    <td>@invoice.Client?.FullName</td>
                    <td>@invoice.InvoiceDate.ToString("dd/MM/yyyy")</td>
                    <td>@invoice.TotalAmount.ToString("N2") EUR</td>
                    <td>@invoice.Status</td>
                </tr>
            }
            </tbody>
        </table>
    }
    else
    {
        <p class="empty">@T.T("NoRecentInvoice")</p>
    }
</div>
