@model EnterpriseERP.Models.Payment
@inject EnterpriseERP.Services.TranslationService T

@{
    ViewData["Title"] = T.T("AddPayment");
    var invoices = ViewBag.Invoices as List<EnterpriseERP.Models.Invoice>;
}

<div class="page-header">
    <div>
        <h1>@T.T("AddPayment")</h1>
        <p>@T.T("AddPaymentDescription")</p>
    </div>

    <a href="/Payments/Index" class="btn-secondary">
        @T.T("Back")
    </a>
</div>

<div class="form-card">
    @if (ViewBag.Error != null)
    {
        <div class="alert-error">@ViewBag.Error</div>
    }

    <form method="post" action="/Payments/Create">
        @Html.AntiForgeryToken()

        <div class="form-group">
            <label>@T.T("Invoice")</label>
            <select name="InvoiceId" required>
                <option value="">@T.T("SelectInvoice")</option>

                @if (invoices != null)
                {
                    foreach (var invoice in invoices)
                    {
                        <option value="@invoice.Id">
                            @T.T("Invoice") #@invoice.Id - @invoice.Client?.FullName - @invoice.TotalAmount EUR - @invoice.Status
                        </option>
                    }
                }
            </select>
        </div>

        <div class="form-group">
            <label>@T.T("PaidAmount")</label>
            <input name="Amount" type="number" step="0.01" min="1" required />
        </div>

        <div class="form-group">
            <label>@T.T("PaymentMethod")</label>
            <select name="Method">
                <option value="Cash">@T.T("Cash")</option>
                <option value="Card">@T.T("Card")</option>
                <option value="Bank Transfer">@T.T("BankTransfer")</option>
                <option value="Swish">Swish</option>
                <option value="Mobile Money">Mobile Money</option>
            </select>
        </div>

        <div class="form-group">
            <label>@T.T("Reference")</label>
            <input name="Reference" placeholder="@T.T("ReferencePlaceholder")" />
        </div>

        <button type="submit" class="btn-primary">
            @T.T("SavePayment")
        </button>
    </form>
</div>
