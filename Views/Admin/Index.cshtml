@inject EnterpriseERP.Services.TranslationService T
@{
    ViewData["Title"] = T.T("AdminCenterTitle");
}

<div class="page-header">
    <div>
        <h1>@T.T("AdminCenterTitle")</h1>
        <p>@T.T("AdminCenterText")</p>
    </div>

    <a href="/Dashboard" class="btn-secondary">@T.T("BackToDashboard")</a>
</div>

<div class="stats-grid">
    <div class="stat-card"><div class="stat-icon">USR</div><div><h3>@ViewBag.UsersCount</h3><p>@T.T("Users")</p></div></div>
    <div class="stat-card"><div class="stat-icon">ACT</div><div><h3>@ViewBag.ActiveUsers</h3><p>@T.T("ActiveAccounts")</p></div></div>
    <div class="stat-card warning"><div class="stat-icon">SEC</div><div><h3>@ViewBag.SecurityWarnings</h3><p>@T.T("SecurityAlerts")</p></div></div>
    <div class="stat-card"><div class="stat-icon">KEY</div><div><h3>@ViewBag.PermissionsCount</h3><p>Permissions</p></div></div>
</div>

<div class="dashboard-grid">
    <div class="panel">
        <h2>@T.T("UserManagement")</h2>
        <p>@T.T("UserManagementText")</p>
        <a href="/Account/Register" class="btn-primary">@T.T("CreateUser")</a>
        <a href="/Users/Index" class="btn-secondary">@T.T("Users")</a>
    </div>

    <div class="panel">
        <h2>@T.T("RolesPermissions")</h2>
        <p>@T.T("RolesText")</p>
        <a href="/Roles/Index" class="btn-primary">@T.T("ManagePermissions")</a>
    </div>

    <div class="panel">
        <h2>@T.T("AuditLog")</h2>
        <p>@T.T("AuditLogText")</p>
        <a href="/Audit/Index" class="btn-primary">@T.T("OpenAudit")</a>
    </div>

    <div class="panel">
        <h2>@T.T("SystemSettings")</h2>
        <p>@T.T("SystemSettingsText")</p>
        <a href="/Settings/Index" class="btn-primary">@T.T("Settings")</a>
    </div>

    <div class="panel">
        <h2>@T.T("Notifications")</h2>
        <p>@T.T("NotificationsText")</p>
        <a href="/Notifications/Index" class="btn-primary">@T.T("Notifications")</a>
    </div>

    <div class="panel">
        <h2>Core Platform</h2>
        <p>@T.T("CorePlatformText")</p>
        <a href="/CorePlatform/Index" class="btn-primary">@T.T("OpenCorePlatform")</a>
    </div>

    <div class="panel">
        <h2>@T.T("ExportsReports")</h2>
        <p>@T.T("ExportsReportsText")</p>
        <a href="/Exports/Index" class="btn-primary">@T.T("ExcelExports")</a>
        <a href="/Analytics/Index" class="btn-secondary">Analytics</a>
    </div>

    <div class="panel">
        <h2>@T.T("BackupCenter")</h2>
        <p>@T.T("BackupText")</p>
        <a href="/Backup/Index" class="btn-primary">@T.T("OpenBackupCenter")</a>
    </div>

    <div class="panel">
        <h2>@T.T("SecurityCenter")</h2>
        <p>@T.T("SecurityText")</p>
        <a href="/Security/Index" class="btn-primary">@T.T("OpenSecurityCenter")</a>
    </div>
</div>
