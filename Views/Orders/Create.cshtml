@model EnterpriseERP.Models.Order
@inject EnterpriseERP.Services.TranslationService T

@{
    ViewData["Title"] = T.T("NewOrder");
    var clients = ViewBag.Clients as List<EnterpriseERP.Models.Client>;
    var products = ViewBag.Products as List<EnterpriseERP.Models.Product>;
}

<div class="page-header">
    <div>
        <h1>@T.T("NewOrder")</h1>
        <p>@T.T("NewOrderDescription")</p>
    </div>

    <a asp-controller="Orders" asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i>
        @T.T("BackToList")
    </a>
</div>

<div class="form-card">
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger mb-4">
            @ViewBag.Error
        </div>
    }

    <form asp-controller="Orders" asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="form-group mb-4">
            <label class="form-label fw-bold">
                <i class="bi bi-person"></i>
                @T.T("Client")
            </label>
            <select name="ClientId" class="form-select" required>
                <option value="">@T.T("SelectClient")</option>
                @if (clients != null)
                {
                    foreach (var client in clients)
                    {
                        <option value="@client.Id">@client.FullName</option>
                    }
                }
            </select>
        </div>

        <div class="form-group mb-4">
            <label class="form-label fw-bold">
                <i class="bi bi-box-seam"></i>
                @T.T("Product")
            </label>
            <select name="ProductId" class="form-select" required>
                <option value="">@T.T("SelectProduct")</option>
                @if (products != null)
                {
                    foreach (var product in products)
                    {
                        <option value="@product.Id">
                            @product.Name - @product.SalePrice.ToString("N2") EUR - @T.T("Stock"): @product.Quantity
                        </option>
                    }
                }
            </select>
        </div>

        <div class="form-group mb-4">
            <label class="form-label fw-bold">
                <i class="bi bi-123"></i>
                @T.T("Quantity")
            </label>
            <input name="Quantity" type="number" min="1" value="1" class="form-control" required />
        </div>

        <div class="form-group mb-5">
            <label class="form-label fw-bold">
                <i class="bi bi-check-circle"></i>
                @T.T("Status")
            </label>
            <select name="Status" class="form-select">
                <option value="Pending">@T.T("Pending")</option>
                <option value="Confirmed">@T.T("Confirmed")</option>
                <option value="Delivered">@T.T("Delivered")</option>
                <option value="Cancelled">@T.T("Cancelled")</option>
            </select>
        </div>

        <div class="d-flex justify-content-between">
            <a asp-controller="Orders" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i>
                @T.T("Back")
            </a>

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-save"></i>
                @T.T("SaveOrder")
            </button>
        </div>
    </form>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}
