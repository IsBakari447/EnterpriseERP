@model EnterpriseERP.Models.Employee
@inject EnterpriseERP.Services.TranslationService T

@{
    ViewData["Title"] = T.T("DeleteEmployee");
}

<div class="page-header">
    <div>
        <h1>@T.T("DeleteEmployee")</h1>
        <p>@T.T("DeleteConfirmation")</p>
    </div>

    <a href="/Employees/Index" class="btn-secondary">
        @T.T("BackToList")
    </a>
</div>

<div class="form-card">
    <div class="alert-error">
        @T.T("DeleteEmployeeQuestion")
    </div>

    <p>
        <strong>@T.T("Name"):</strong> @Model.FullName
    </p>

    <p>
        <strong>@T.T("Position"):</strong> @Model.Position
    </p>

    <p>
        <strong>@T.T("Email"):</strong> @Model.Email
    </p>

    <form method="post" action="/Employees/DeleteConfirmed/@Model.Id">
        @Html.AntiForgeryToken()

        <button type="submit" class="btn-danger">
            @T.T("YesDelete")
        </button>

        <a href="/Employees/Index" class="btn-secondary">
            @T.T("Cancel")
        </a>
    </form>
</div>
